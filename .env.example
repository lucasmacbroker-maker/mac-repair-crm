# Base de données PostgreSQL (Neon)
DATABASE_URL="postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Secret JWT pour l'authentification
JWT_SECRET="votre-secret-jwt-super-securise-changez-moi"

# URL de base de l'application
NEXT_PUBLIC_APP_URL="https://votre-domaine.vercel.app"

# Configuration email (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="votre-email@gmail.com"
SMTP_PASS="votre-mot-de-passe-application"
SMTP_FROM="Mac Place <votre-email@gmail.com>"

# Nom de l'entreprise
NEXT_PUBLIC_COMPANY_NAME="Mac Place"
NEXT_PUBLIC_COMPANY_PHONE="07 82 71 21 23"
NEXT_PUBLIC_COMPANY_EMAIL="contact@macplace.fr"
NEXT_PUBLIC_COMPANY_ADDRESS="5 rue Paul Vaillant Couturier, 94700 Maisons-Alfort"

# Module Reprises (site reprise.macplace.fr)
# Clé partagée avec le site de reprise (variable CRM_API_KEY côté site). Longue chaîne aléatoire.
BUYBACK_API_KEY="changez-moi-chaine-aleatoire-longue"
# Clé de chiffrement des IBAN des clients. Ne JAMAIS la changer une fois des reprises enregistrées.
BUYBACK_ENCRYPTION_KEY="changez-moi-autre-chaine-aleatoire-longue"
# E-mail qui reçoit les alertes de nouvelles reprises (par défaut SMTP_USER)
SMTP_ADMIN_EMAIL=""
