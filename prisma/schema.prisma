generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      String   @default("TECHNICIAN") // SUPER_ADMIN, TECHNICIAN
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repairs       Repair[]       @relation("AssignedTechnician")
  statusChanges StatusChange[]
  repairNotes   RepairNote[]
}

model Repair {
  id               String   @id @default(uuid())
  token            String   @unique @default(uuid())

  // Client info
  clientFirstName  String
  clientLastName   String
  clientEmail      String
  clientPhone      String
  clientAddress    String   @default("")
  clientCity       String   @default("")
  clientPostalCode String   @default("")

  // Mac info
  macModel         String
  serialNumber     String   @default("")
  faultType        String
  faultDescription String   @default("")

  // Repair info
  repairType       String   // POSTAL or LOCAL
  status           String   @default("PENDING")
  priority         String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT

  // Tracking
  inboundTracking  String   @default("")
  outboundTracking String   @default("")
  carrier          String   @default("")
  trackingLink     String   @default("")
  paymentLink      String   @default("")

  // Financials
  estimatedCost    Float    @default(0)
  finalCost        Float    @default(0)

  // Dates
  estimatedReturn  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  closedAt         DateTime?

  // Appointment (LOCAL repairs)
  appointmentDate  DateTime?

  // Quote validation
  quoteValidated   Boolean  @default(false)
  quoteValidatedAt DateTime?

  // Relations
  technicianId     String?
  technician       User?          @relation("AssignedTechnician", fields: [technicianId], references: [id])
  statusChanges    StatusChange[]
  notes            RepairNote[]
  partsUsed        RepairPart[]
  attachments      RepairAttachment[]
}

model StatusChange {
  id        String   @id @default(uuid())
  repairId  String
  repair    Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  fromStatus String
  toStatus   String
  createdAt DateTime @default(now())
}

model RepairNote {
  id         String   @id @default(uuid())
  repairId   String
  repair     Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  content    String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Part {
  id            String       @id @default(uuid())
  name          String
  sku           String       @unique
  category      String
  compatibility String       @default("") // comma-separated Mac models
  quantity      Int          @default(0)
  alertThreshold Int         @default(5)
  purchasePrice Float        @default(0)
  sellPrice     Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  movements     StockMovement[]
  repairParts   RepairPart[]
}

model StockMovement {
  id        String   @id @default(uuid())
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  type      String   // IN or OUT
  quantity  Int
  reason    String   @default("")
  repairId  String?
  createdAt DateTime @default(now())
}

model RepairPart {
  id        String   @id @default(uuid())
  repairId  String
  repair    Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  partId    String
  part      Part     @relation(fields: [partId], references: [id])
  quantity  Int      @default(1)
  unitPrice Float    @default(0)
  createdAt DateTime @default(now())
}

model Client {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String   @default("")
  source    String   @default("import") // "import" or "manual"
  createdAt DateTime @default(now())
}

model RepairAttachment {
  id         String   @id @default(uuid())
  repairId   String
  repair     Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  fileName   String
  storedName String   @unique
  url        String   @default("")
  mimeType   String
  size       Int
  type       String   // Devis, Facture, Photo, Autre
  createdAt  DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  color       String   @default("#0071e3")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
}

model Task {
  id          String    @id @default(uuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  status      String    @default("TODO") // TODO, IN_PROGRESS, DONE
  priority    String    @default("NORMAL") // LOW, NORMAL, HIGH
  dueDate     DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Prospect {
  id                 String    @id @default(uuid())
  // Identité
  firstName          String
  lastName           String
  email              String    @default("")
  phone              String    @default("")
  company            String    @default("")
  position           String    @default("")
  linkedinUrl        String    @default("")
  source             String    @default("LinkedIn")
  // Suivi
  status             String    @default("NOT_CONTACTED")
  priority           String    @default("MEDIUM")
  temperature        String    @default("COLD")
  // Dates
  firstContactDate   DateTime?
  lastInteraction    DateTime?
  nextFollowUp       DateTime?
  conversionDeadline DateTime?
  // Relance
  needsCallback      Boolean   @default(false)
  // CA potentiel
  revenuePotential   Float     @default(0)
  // Relations
  notes              ProspectNote[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ProspectNote {
  id         String   @id @default(uuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  content    String
  type       String   @default("NOTE") // NOTE, CALL, EMAIL, LINKEDIN, MEETING
  createdAt  DateTime @default(now())
}
